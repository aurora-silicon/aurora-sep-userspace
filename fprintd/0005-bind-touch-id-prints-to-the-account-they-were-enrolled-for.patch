+/* A print's path below its account's storage directory. */
+static char *
+get_print_key (const char *driver, const char *device_id, FpFinger finger)
+{
+  char fingername[2];
+
+  g_snprintf (fingername, 2, "%x", finger);
+  return g_build_filename (driver, device_id, fingername, NULL);
+}
+
 int
 file_storage_print_data_save (FpPrint *print)
 {
@@ -164,6 +179,21 @@ file_storage_print_data_save (FpPrint *print)
       return err->code;
     }
 
+  if (g_strcmp0 (fp_print_get_driver (print), BOUND_DRIVER) == 0)
+    {
+      g_autofree char *key = get_print_key (fp_print_get_driver (print),
+                                            fp_print_get_device_id (print),
+                                            fp_print_get_finger (print));
+
+      if (!account_binding_bind (base_store, fp_print_get_username (print),
+                                 BOUND_DRIVER, key, &err))
+        {
+          g_warning ("Not keeping %s: %s", path, err->message);
+          g_unlink (path);
+          return -EIO;
+        }
+    }
+
   g_debug ("file_storage_print_data_save(): print saved to %s", path);
 
   return 0;
@@ -254,6 +284,15 @@ file_storage_print_data_delete (FpDevice *dev, FpFinger finger, const char *user
   g_debug ("file_storage_print_data_delete(): unlink(\"%s\") %s",
            path, g_strerror (r));
 
+  if (r == 0 && g_strcmp0 (fp_device_get_driver (dev), BOUND_DRIVER) == 0)
+    {
+      g_autofree char *key = get_print_key (fp_device_get_driver (dev),
+                                            fp_device_get_device_id (dev),
+                                            finger);
+
+      account_binding_forget (base_store, key);
+    }
+
   prints = file_storage_discover_prints (dev, username);
   if (!prints)
     {
@@ -329,6 +368,20 @@ file_storage_discover_prints (FpDevice *dev, const char *username)
   return list;
 }
 
+gboolean
+file_storage_print_is_bound (FpDevice *dev, FpFinger finger, const char *username)
+{
+  g_autofree char *base_store = NULL;
+  g_autofree char *key = NULL;
+
+  if (g_strcmp0 (fp_device_get_driver (dev), BOUND_DRIVER) != 0)
+    return TRUE;
+
+  base_store = file_storage_get_basestore_for_username (username);
+  key = get_print_key (fp_device_get_driver (dev), fp_device_get_device_id (dev), finger);
+  return account_binding_is_bound (base_store, username, BOUND_DRIVER, key);
+}
