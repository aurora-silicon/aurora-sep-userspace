 }
 
+/* Whether a stored print belongs to the account its username names now, and
+ * so may verify, be listed or stand in the way of an enrolment. Prints that
+ * an earlier account of the same name left behind can still be deleted. */
+static gboolean
+print_is_bound (FprintDevice *rdev,
+                FpFinger      finger,
+                const char   *username)
+{
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+
+  if (store.print_is_bound == NULL || store.print_is_bound (priv->dev, finger, username))
+    return TRUE;
+
+  g_message ("Ignoring the %s print that an earlier account named %s left behind",
+             fp_finger_to_name (finger), username);
+  return FALSE;
+}
+
+static GPtrArray *
+load_bound_user_prints (FprintDevice *rdev,
+                        const char   *username)
+{
+  g_autoptr(GPtrArray) prints = load_user_prints (rdev, username);
+  guint i = 0;
+
+  while (i < prints->len)
+    {
+      FpPrint *print = g_ptr_array_index (prints, i);
+
+      if (print_is_bound (rdev, fp_print_get_finger (print), username))
+        i++;
+      else
+        g_ptr_array_remove_index (prints, i);
+    }
+
+  return g_steal_pointer (&prints);
+}
+
 static GPtrArray *
 load_all_prints (FprintDevice *rdev)
 {
@@ -1713,7 +1751,7 @@ fprint_device_verify_start (FprintDBusDevice      *dbus_dev,
 
   if (finger == FP_FINGER_UNKNOWN)
     {
-      gallery = load_user_prints (rdev, session->username);
+      gallery = load_bound_user_prints (rdev, session->username);
 
       if (!gallery->len)
         {
@@ -1777,6 +1815,8 @@ fprint_device_verify_start (FprintDBusDevice      *dbus_dev,
       else
         {
           store.print_data_load (priv->dev, finger, session->username, &print);
+          if (print && !print_is_bound (rdev, finger, session->username))
+            g_clear_object (&print);
         }
 
       if (!print)
@@ -2289,7 +2329,7 @@ fprint_device_enroll_start (FprintDBusDevice      *dbus_dev,
 
   if (existing_print)
     {
-      if (aurora)
+      if (aurora && print_is_bound (rdev, finger, session->username))
         {
           g_set_error (&error, FPRINT_ERROR, FPRINT_ERROR_FINGER_ALREADY_ENROLLED,
                        "finger already enrolled; delete it explicitly before enrolling again");
@@ -2399,7 +2439,7 @@ fprint_device_list_enrolled_fingers (FprintDBusDevice      *dbus_dev,
 
   user = g_object_get_qdata (G_OBJECT (invocation), quark_auth_user);
   g_assert (user);
-  prints = load_user_prints (rdev, user);
+  prints = load_bound_user_prints (rdev, user);
 
   ret = g_ptr_array_new ();
   for (i = 0; i < prints->len; i++)
