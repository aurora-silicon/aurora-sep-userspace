index 0000000..19179ed
--- /dev/null
+++ b/src/account_binding.c
@@ -0,0 +1,266 @@
+/*
+ * Bind stored prints to the account they were enrolled for
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * Prints are stored under a username, and a username outlives its account:
+ * delete an account, create another with the same name, and the new account
+ * would find the old one's prints. So each account's storage directory keeps
+ * a record of the account its prints belong to: its uid and an instance
+ * GUID, and the instance each print was enrolled under. A print belongs to
+ * the account that the username names now only while that account has the
+ * recorded uid and the print carries the recorded instance.
+ *
+ * A record whose uid no longer matches is replaced, with a new instance, at
+ * the next enrolment. Account removal invalidates it (a new instance, no
+ * uid), so that a print the removal could not delete never matches again.
+ * Prints stored before records existed are adopted, all at once, by the
+ * account that holds their username when a record is first needed.
+ */
+
+#include <errno.h>
+#include <pwd.h>
+#include <string.h>
+#include <sys/types.h>
+
+#include "account_binding.h"
+
+#define GROUP_ACCOUNT "Account"
+#define GROUP_PRINTS "Prints"
+#define KEY_UID "UID"
+#define KEY_INSTANCE "Instance"
+
+G_STATIC_ASSERT (sizeof (uid_t) <= sizeof (guint32));
+
+gboolean
+account_binding_lookup_uid (const char *username, guint32 *uid)
+{
+  struct passwd account;
+  struct passwd *found = NULL;
+  char buffer[16384];
+
+  if (username == NULL || *username == '\0')
+    return FALSE;
+
+  if (getpwnam_r (username, &account, buffer, sizeof (buffer), &found) != 0 ||
+      found == NULL || g_strcmp0 (found->pw_name, username) != 0 ||
+      found->pw_uid == (uid_t) -1)
+    return FALSE;
+
+  *uid = found->pw_uid;
+  return TRUE;
+}
+
+static char *
+record_path (const char *base_store)
+{
+  return g_build_filename (base_store, ACCOUNT_BINDING_RECORD, NULL);
+}
+
+/* Print keys are paths below the account's storage directory. Escape them
+ * so that no key file syntax ('=', '[', ']') or whitespace can occur. */
+static char *
+escape_key (const char *key)
+{
+  return g_uri_escape_string (key, "/", FALSE);
+}
+
+/* The record, or NULL with missing set when the account has none. A record
+ * that exists but cannot be read is not missing: nothing is adopted then. */
+static GKeyFile *
+record_load (const char *base_store, gboolean *missing)
+{
+  g_autoptr(GKeyFile) record = g_key_file_new ();
+  g_autoptr(GError) error = NULL;
+  g_autofree char *path = record_path (base_store);
+
+  *missing = FALSE;
+  if (g_key_file_load_from_file (record, path, G_KEY_FILE_NONE, &error))
+    return g_steal_pointer (&record);
+
+  if (g_error_matches (error, G_FILE_ERROR, G_FILE_ERROR_NOENT))
+    *missing = TRUE;
+  else
+    g_warning ("Ignoring unreadable account record %s: %s", path, error->message);
+
+  return NULL;
+}
+
+static gboolean
+record_save (const char *base_store, GKeyFile *record, GError **error)
+{
+  g_autofree char *path = record_path (base_store);
+  g_autofree char *data = NULL;
+  gsize length;
+
+  if (g_mkdir_with_parents (base_store, 0700) < 0)
+    {
+      g_set_error (error, G_FILE_ERROR, g_file_error_from_errno (errno),
+                   "Could not create %s: %s", base_store, g_strerror (errno));
+      return FALSE;
+    }
+
+  data = g_key_file_to_data (record, &length, NULL);
+  return g_file_set_contents (path, data, length, error);
+}
+
+static GKeyFile *
+record_new (guint32 uid)
+{
+  GKeyFile *record = g_key_file_new ();
+  g_autofree char *instance = g_uuid_string_random ();
+
+  g_key_file_set_uint64 (record, GROUP_ACCOUNT, KEY_UID, uid);
+  g_key_file_set_string (record, GROUP_ACCOUNT, KEY_INSTANCE, instance);
+  return record;
+}
+
+static gboolean
+is_print_name (const char *name)
+{
+  /* Print files are named by a single hex digit, the finger. */
+  return name[0] != '\0' && name[1] == '\0' && g_ascii_isxdigit (name[0]);
+}
+
+/* A first record for an account whose prints were stored before records
+ * existed: every print of the driver stored under the username is its own. */
+static GKeyFile *
+record_adopt (const char *base_store, guint32 uid, const char *driver)
+{
+  g_autoptr(GKeyFile) record = record_new (uid);
+  g_autofree char *instance = g_key_file_get_string (record, GROUP_ACCOUNT, KEY_INSTANCE, NULL);
+  g_autofree char *driver_dir = g_build_filename (base_store, driver, NULL);
+  g_autoptr(GDir) devices = g_dir_open (driver_dir, 0, NULL);
+  const char *device;
+
+  while (devices && (device = g_dir_read_name (devices)))
+    {
+      g_autofree char *device_dir = g_build_filename (driver_dir, device, NULL);
+      g_autoptr(GDir) prints = g_dir_open (device_dir, 0, NULL);
+      const char *print;
+
+      while (prints && (print = g_dir_read_name (prints)))
+        {
+          g_autofree char *key = NULL;
+          g_autofree char *escaped = NULL;
+
+          if (!is_print_name (print))
+            continue;
+
+          key = g_build_filename (driver, device, print, NULL);
+          escaped = escape_key (key);
+          g_key_file_set_string (record, GROUP_PRINTS, escaped, instance);
+        }
+    }
+
+  return g_steal_pointer (&record);
+}
+
+/* The record's instance when it is the record of the account with `uid`. */
+static char *
+record_instance_for (GKeyFile *record, guint32 uid)
+{
+  g_autoptr(GError) error = NULL;
+  guint64 recorded = g_key_file_get_uint64 (record, GROUP_ACCOUNT, KEY_UID, &error);
+
+  if (error != NULL || recorded != uid)
+    return NULL;
+
+  return g_key_file_get_string (record, GROUP_ACCOUNT, KEY_INSTANCE, NULL);
+}
+
+gboolean
+account_binding_bind (const char *base_store,
+                      const char *username,
+                      const char *driver,
+                      const char *key,
+                      GError    **error)
+{
+  g_autoptr(GKeyFile) record = NULL;
+  g_autofree char *instance = NULL;
+  g_autofree char *escaped = NULL;
+  gboolean missing;
+  guint32 uid;
+
+  if (!account_binding_lookup_uid (username, &uid))
+    {
+      g_set_error (error, G_FILE_ERROR, G_FILE_ERROR_NOENT,
+                   "Unix account '%s' has no passwd entry or uid", username ? username : "");
+      return FALSE;
+    }
+
+  record = record_load (base_store, &missing);
+  if (record == NULL && missing)
+    record = record_adopt (base_store, uid, driver);
+  if (record != NULL)
+    instance = record_instance_for (record, uid);
+  if (instance == NULL)
+    {
+      /* Another account's record, an invalidated one or an unreadable one:
+       * this account starts a new instance, and none of the stored prints
+       * belong to it. */
+      g_clear_pointer (&record, g_key_file_unref);
+      record = record_new (uid);
+      instance = g_key_file_get_string (record, GROUP_ACCOUNT, KEY_INSTANCE, NULL);
+    }
+
+  escaped = escape_key (key);
+  g_key_file_set_string (record, GROUP_PRINTS, escaped, instance);
+  return record_save (base_store, record, error);
+}
+
+gboolean
+account_binding_is_bound (const char *base_store,
+                          const char *username,
+                          const char *driver,
+                          const char *key)
+{
+  g_autoptr(GKeyFile) record = NULL;
+  g_autofree char *instance = NULL;
+  g_autofree char *escaped = NULL;
+  g_autofree char *enrolled_under = NULL;
+  gboolean missing;
+  guint32 uid;
+
+  if (!account_binding_lookup_uid (username, &uid))
+    return FALSE;
+
+  record = record_load (base_store, &missing);
+  if (record == NULL && missing)
+    {
+      g_autoptr(GError) error = NULL;
+
+      record = record_adopt (base_store, uid, driver);
+      if (!record_save (base_store, record, &error))
+        g_warning ("Could not record the account of %s's prints: %s", username, error->message);
+    }
+  if (record == NULL)
+    return FALSE;
+
+  instance = record_instance_for (record, uid);
+  if (instance == NULL)
+    return FALSE;
+
+  escaped = escape_key (key);
+  enrolled_under = g_key_file_get_string (record, GROUP_PRINTS, escaped, NULL);
+  return g_strcmp0 (enrolled_under, instance) == 0;
+}
+
+void
+account_binding_forget (const char *base_store, const char *key)
+{
+  g_autoptr(GKeyFile) record = NULL;
+  g_autoptr(GError) error = NULL;
+  g_autofree char *escaped = escape_key (key);
+  gboolean missing;
+
+  record = record_load (base_store, &missing);
+  if (record == NULL || !g_key_file_remove_key (record, GROUP_PRINTS, escaped, NULL))
+    return;
+
+  if (!record_save (base_store, record, &error))
+    g_warning ("Could not update the account record in %s: %s", base_store, error->message);
+}
