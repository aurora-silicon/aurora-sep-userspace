+/* Touch ID keeps every account's fingerprints in one enclave, and its prints
+ * are bound to the account they were enrolled for (account_binding.c). */
+#define BOUND_DRIVER "apple-sep"
+
 #define FILE_STORAGE_PATH "/var/lib/fprint"
