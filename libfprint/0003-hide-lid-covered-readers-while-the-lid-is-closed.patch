From c5e1b20255e34278a9dd844f84f78324014c2e93 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Thu, 15 Oct 2026 11:51:37 +1100
Subject: [PATCH] Hide lid-covered readers while the lid is closed

A reader built into a laptop's base -- in the palm rest, the keyboard or
the power button -- cannot be touched while the lid is closed. libfprint
still reported it, so in clamshell mode every sudo, polkit request and
lock screen offered the fingerprint and then waited for a finger that
could not come.

Let a driver say its sensor is covered by the lid
(FpDeviceClass:covered_by_lid). FpContext then follows the lid switches
(SW_LID input devices, read with EVIOCGSW) and removes such a device
while a lid is closed: fpi_device_remove() fails a running operation as
FP_DEVICE_ERROR_REMOVED, and the context drops the device once its user
has closed it. The udev match is kept, so the device is probed again,
and announced through device-added, as soon as the lid opens. A device
matched while the lid is closed is only probed once it opens. Without a
lid switch nothing changes.

fprintd already follows device-added and device-removed. pam_fprintd
finds no device and returns PAM_AUTHINFO_UNAVAIL at once, so sudo and
polkit go straight to the password without a fingerprint prompt or a
delay; lock screens that ask fprintd for a reader see none.

The aurora driver sets the flag. When it is removed it cancels the
enclave operation in flight and refuses to arm the sensor again, so a
verify waiting when the lid closes ends promptly as verify-disconnected
and pam_fprintd moves on to the password.

Also release the misc devices left over after udev matching.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
---
 libfprint/drivers/aurora/aurora.c |  56 +++++
 libfprint/fp-context.c            | 273 +++++++++++++++++++++++--
 libfprint/fpi-device.h            |   8 +
 libfprint/fpi-lid-switch.c        | 327 ++++++++++++++++++++++++++++++
 libfprint/fpi-lid-switch.h        |  29 +++
 libfprint/meson.build             |   8 +-
 6 files changed, 683 insertions(+), 18 deletions(-)
 create mode 100644 libfprint/fpi-lid-switch.c
 create mode 100644 libfprint/fpi-lid-switch.h

diff --git a/libfprint/drivers/aurora/aurora.c b/libfprint/drivers/aurora/aurora.c
index 2b44d579..51d05c29 100644
--- a/libfprint/drivers/aurora/aurora.c
+++ b/libfprint/drivers/aurora/aurora.c
@@ -192,6 +192,16 @@ aurora_label_from_print (FpPrint *print, guint8 *label_out, GError **error)
   return TRUE;
 }
 
+/* Set once a closed lid has covered the sensor: see aurora_removed_cb(). */
+static gboolean
+aurora_is_removed (FpDevice *device)
+{
+  gboolean removed = FALSE;
+
+  g_object_get (device, "removed", &removed, NULL);
+  return removed;
+}
+
 static void
 aurora_stop_watch (FpiDeviceAurora *self)
 {
@@ -366,6 +376,12 @@ aurora_open (FpDevice *device)
   FpiDeviceAurora *self = FPI_DEVICE_AURORA (device);
   const gchar *path;
 
+  if (aurora_is_removed (device))
+    {
+      fpi_device_open_complete (device, fpi_device_error_new (FP_DEVICE_ERROR_REMOVED));
+      return;
+    }
+
   path = fpi_device_get_udev_data (device, FPI_DEVICE_UDEV_SUBTYPE_MISC);
   if (path == NULL)
     {
@@ -425,6 +441,27 @@ aurora_cancel (FpDevice *device)
     ioctl (self->fd, SEP_BIO_CANCEL);
 }
 
+/* The sensor is in the power button, so a closed lid covers it, and the
+ * context removes this device then (covered_by_lid below). An operation still
+ * waiting for a finger can never finish: cancel it in the enclave, and libfprint
+ * completes it as FP_DEVICE_ERROR_REMOVED, which fprintd reports as
+ * verify-disconnected and pam_fprintd answers by moving on to the password.
+ * The device stays open until its user releases it; refuse anything that would
+ * arm the sensor again in the meantime. */
+static void
+aurora_removed_cb (FpDevice *device, GParamSpec *pspec, gpointer user_data)
+{
+  FpiDeviceAurora *self = FPI_DEVICE_AURORA (device);
+
+  if (!aurora_is_removed (device))
+    return;
+
+  fp_dbg ("device removed%s", self->watch_id != 0 ? "; cancelling the running operation" : "");
+
+  if (self->watch_id != 0)
+    aurora_cancel (device);
+}
+
 static void
 aurora_report_guidance (FpDevice *device, guint32 guidance, gboolean active)
 {
@@ -532,6 +569,12 @@ aurora_enroll (FpDevice *device)
   g_autoptr(GError) error = NULL;
   FpPrint *print = NULL;
 
+  if (aurora_is_removed (device))
+    {
+      fpi_device_enroll_complete (device, NULL, fpi_device_error_new (FP_DEVICE_ERROR_REMOVED));
+      return;
+    }
+
   fpi_device_get_enroll_data (device, &print);
 
   if (!aurora_label_from_print (print, start.label, &error))
@@ -801,6 +844,16 @@ aurora_match_start (FpDevice *device)
         }
     }
 
+  if (aurora_is_removed (device))
+    {
+      error = fpi_device_error_new (FP_DEVICE_ERROR_REMOVED);
+      if (action == FPI_DEVICE_ACTION_VERIFY)
+        fpi_device_verify_complete (device, g_steal_pointer (&error));
+      else
+        fpi_device_identify_complete (device, g_steal_pointer (&error));
+      return;
+    }
+
   /* A fresh nonce per operation is what makes the result non-replayable. If we
    * cannot get one we must not fall back to anything weaker. */
   if (getrandom (self->nonce, sizeof (self->nonce), 0) != (gssize) sizeof (self->nonce))
@@ -930,6 +983,8 @@ fpi_device_aurora_init (FpiDeviceAurora *self)
   self->fd = -1;
   self->watch_id = 0;
   self->nonce_valid = FALSE;
+
+  g_signal_connect (self, "notify::removed", G_CALLBACK (aurora_removed_cb), NULL);
 }
 
 static void
@@ -965,6 +1020,7 @@ fpi_device_aurora_class_init (FpiDeviceAuroraClass *klass)
   dev_class->scan_type = FP_SCAN_TYPE_PRESS;
   dev_class->nr_enroll_stages = 8;
   dev_class->temp_hot_seconds = -1;
+  dev_class->covered_by_lid = TRUE;
 
   dev_class->probe = aurora_probe;
   dev_class->open = aurora_open;
diff --git a/libfprint/fp-context.c b/libfprint/fp-context.c
index 6fdf53b4..2c072053 100644
--- a/libfprint/fp-context.c
+++ b/libfprint/fp-context.c
@@ -29,6 +29,7 @@
 
 #ifdef HAVE_UDEV
 #include <gudev/gudev.h>
+#include "fpi-lid-switch.h"
 #endif
 
 /**
@@ -55,6 +56,11 @@ typedef struct
 
   GArray       *drivers;
   GPtrArray    *devices;
+
+#ifdef HAVE_UDEV
+  FpiLidSwitch *lid;
+  GPtrArray    *lid_covered;
+#endif
 } FpContextPrivate;
 
 G_DEFINE_TYPE_WITH_PRIVATE (FpContext, fp_context, G_TYPE_OBJECT)
@@ -96,17 +102,67 @@ typedef struct
   GSource   *source;
 } RemoveDeviceData;
 
+#ifdef HAVE_UDEV
+/* A udev device whose sensor a closed lid covers (FpDeviceClass:covered_by_lid).
+ *
+ * Nobody can touch such a sensor while the lid is closed, so the device is
+ * removed then, and anyone asking for a reader sees none instead of one that
+ * waits for a finger that cannot come. This record outlives the FpDevice
+ * instances made from it, so the device can be probed again once the lid
+ * opens. */
+typedef struct
+{
+  FpContext *context;     /* NULL once the context is gone */
+  GType      driver;
+  guint64    driver_data;
+  gchar     *spidev_path;
+  gchar     *hidraw_path;
+  gchar     *misc_path;
+  FpDevice  *device;      /* current instance, until the context drops it */
+  gboolean   probing;
+} LidCoveredDevice;
+
+static void lid_covered_probe (FpContext        *context,
+                               LidCoveredDevice *covered);
+#endif
+
 static gboolean
 remove_device_idle_cb (RemoveDeviceData *data)
 {
   FpContextPrivate *priv = fp_context_get_instance_private (data->context);
   guint idx = 0;
 
+#ifdef HAVE_UDEV
+  LidCoveredDevice *covered = NULL;
+  guint i;
+#endif
+
   g_return_val_if_fail (g_ptr_array_find (priv->devices, data->device, &idx), G_SOURCE_REMOVE);
 
+#ifdef HAVE_UDEV
+  for (i = 0; priv->lid_covered && i < priv->lid_covered->len; i++)
+    {
+      LidCoveredDevice *c = g_ptr_array_index (priv->lid_covered, i);
+
+      if (c->device == data->device)
+        {
+          c->device = NULL;
+          covered = c;
+          break;
+        }
+    }
+#endif
+
   g_signal_emit (data->context, signals[DEVICE_REMOVED_SIGNAL], 0, data->device);
   g_ptr_array_remove_index_fast (priv->devices, idx);
 
+#ifdef HAVE_UDEV
+  /* The lid may have opened again while the old instance was still open. It
+   * is gone now, so the node is free for a new one. */
+  if (covered && !fpi_lid_switch_get_closed (priv->lid))
+    lid_covered_probe (data->context, covered);
+#endif
+
   return G_SOURCE_REMOVE;
 }
 
@@ -166,6 +222,21 @@ device_removed_cb (FpContext *context, FpDevice *device)
     }
 }
 
+static void
+add_device (FpContext *context, FpDevice *device)
+{
+  FpContextPrivate *priv = fp_context_get_instance_private (context);
+
+  g_ptr_array_add (priv->devices, device);
+
+  g_signal_connect_object (device, "removed",
+                           (GCallback) device_removed_cb,
+                           context,
+                           G_CONNECT_SWAPPED);
+
+  g_signal_emit (context, signals[DEVICE_ADDED_SIGNAL], 0, device);
+}
+
 static void
 async_device_init_done_cb (GObject *source_object, GAsyncResult *res, gpointer user_data)
 {
@@ -189,16 +260,159 @@ async_device_init_done_cb (GObject *source_object, GAsyncResult *res, gpointer u
       return;
     }
 
-  g_ptr_array_add (priv->devices, device);
+  add_device (context, device);
+}
 
-  g_signal_connect_object (device, "removed",
-                           (GCallback) device_removed_cb,
-                           context,
-                           G_CONNECT_SWAPPED);
+#ifdef HAVE_UDEV
+static void
+lid_covered_device_free (LidCoveredDevice *covered)
+{
+  g_free (covered->spidev_path);
+  g_free (covered->hidraw_path);
+  g_free (covered->misc_path);
+}
 
-  g_signal_emit (context, signals[DEVICE_ADDED_SIGNAL], 0, device);
+static void
+lid_covered_device_release (LidCoveredDevice *covered)
+{
+  g_rc_box_release_full (covered, (GDestroyNotify) lid_covered_device_free);
 }
 
+static void
+lid_covered_init_done_cb (GObject *source_object, GAsyncResult *res, gpointer user_data)
+{
+  LidCoveredDevice *covered = user_data;
+  g_autoptr(GError) error = NULL;
+  g_autoptr(FpDevice) device = NULL;
+  FpContextPrivate *priv;
+
+  device = FP_DEVICE (g_async_initable_new_finish (G_ASYNC_INITABLE (source_object),
+                                                   res, &error));
+
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED) || !covered->context)
+    {
+      lid_covered_device_release (covered);
+      return;
+    }
+
+  priv = fp_context_get_instance_private (covered->context);
+  priv->pending_devices--;
+  covered->probing = FALSE;
+
+  if (error)
+    {
+      g_message ("Ignoring device due to initialization error: %s", error->message);
+    }
+  else if (fpi_lid_switch_get_closed (priv->lid))
+    {
+      /* The lid closed while the device was being probed. */
+      fp_dbg ("Lid closed during probe; %s stays hidden",
+              fp_device_get_driver (device));
+    }
+  else
+    {
+      covered->device = device;
+      add_device (covered->context, g_steal_pointer (&device));
+    }
+
+  lid_covered_device_release (covered);
+}
+
+static void
+lid_covered_probe (FpContext *context, LidCoveredDevice *covered)
+{
+  FpContextPrivate *priv = fp_context_get_instance_private (context);
+
+  if (covered->device || covered->probing)
+    return;
+
+  covered->probing = TRUE;
+  priv->pending_devices++;
+  g_async_initable_new_async (covered->driver,
+                              G_PRIORITY_LOW,
+                              priv->cancellable,
+                              lid_covered_init_done_cb,
+                              g_rc_box_acquire (covered),
+                              "fpi-driver-data", covered->driver_data,
+                              "fpi-udev-data-spidev", covered->spidev_path,
+                              "fpi-udev-data-hidraw", covered->hidraw_path,
+                              "fpi-udev-data-misc", covered->misc_path,
+                              NULL);
+}
+
+static void
+lid_closed_changed_cb (FpContext *context)
+{
+  FpContextPrivate *priv = fp_context_get_instance_private (context);
+  gboolean closed = fpi_lid_switch_get_closed (priv->lid);
+  guint i;
+
+  for (i = 0; i < priv->lid_covered->len; i++)
+    {
+      LidCoveredDevice *covered = g_ptr_array_index (priv->lid_covered, i);
+
+      if (!closed)
+        {
+          /* Probed now if the old instance is gone, else once it is. */
+          lid_covered_probe (context, covered);
+        }
+      else if (covered->device)
+        {
+          gboolean removed;
+
+          g_object_get (covered->device, "removed", &removed, NULL);
+          if (!removed)
+            {
+              fp_dbg ("Lid closed; removing %s", fp_device_get_driver (covered->device));
+              /* The context drops the device once its user has closed it. */
+              fpi_device_remove (covered->device);
+            }
+        }
+    }
+}
+
+static void
+add_lid_covered_device (FpContext   *context,
+                        GType        driver,
+                        guint64      driver_data,
+                        const gchar *spidev_path,
+                        const gchar *hidraw_path,
+                        const gchar *misc_path)
+{
+  FpContextPrivate *priv = fp_context_get_instance_private (context);
+  LidCoveredDevice *covered;
+
+  if (!priv->lid)
+    {
+      priv->lid = fpi_lid_switch_new ();
+      priv->lid_covered = g_ptr_array_new_with_free_func ((GDestroyNotify) lid_covered_device_release);
+      g_signal_connect_object (priv->lid, "notify::closed",
+                               G_CALLBACK (lid_closed_changed_cb),
+                               context,
+                               G_CONNECT_SWAPPED);
+    }
+
+  covered = g_rc_box_new0 (LidCoveredDevice);
+  covered->context = context;
+  covered->driver = driver;
+  covered->driver_data = driver_data;
+  covered->spidev_path = g_strdup (spidev_path);
+  covered->hidraw_path = g_strdup (hidraw_path);
+  covered->misc_path = g_strdup (misc_path);
+  g_ptr_array_add (priv->lid_covered, covered);
+
+  if (fpi_lid_switch_get_closed (priv->lid))
+    {
+      g_autoptr(FpDeviceClass) cls = g_type_class_ref (driver);
+
+      fp_info ("The lid covers the %s sensor; it appears once the lid opens", cls->id);
+      return;
+    }
+
+  lid_covered_probe (context, covered);
+}
+#endif
+
 static void
 usb_device_added_cb (FpContext *self, GUsbDevice *device, GUsbContext *usb_ctx)
 {
@@ -287,6 +501,20 @@ fp_context_finalize (GObject *object)
 
   g_cancellable_cancel (priv->cancellable);
   g_clear_object (&priv->cancellable);
+
+#ifdef HAVE_UDEV
+  if (priv->lid_covered)
+    {
+      guint i;
+
+      /* Probes still in flight hold their own reference. */
+      for (i = 0; i < priv->lid_covered->len; i++)
+        ((LidCoveredDevice *) g_ptr_array_index (priv->lid_covered, i))->context = NULL;
+    }
+  g_clear_pointer (&priv->lid_covered, g_ptr_array_unref);
+  g_clear_object (&priv->lid);
+#endif
+
   g_clear_pointer (&priv->drivers, g_array_unref);
   g_clear_pointer (&priv->devices, g_ptr_array_unref);
 
@@ -545,17 +773,27 @@ fp_context_enumerate (FpContext *context)
                 if (matched_misc == NULL)
                   continue;
               }
-            priv->pending_devices++;
-            g_async_initable_new_async (driver,
-                                        G_PRIORITY_LOW,
-                                        priv->cancellable,
-                                        async_device_init_done_cb,
-                                        context,
-                                        "fpi-driver-data", entry->driver_data,
-                                        "fpi-udev-data-spidev", (matched_spidev ? g_udev_device_get_device_file (matched_spidev->data) : NULL),
-                                        "fpi-udev-data-hidraw", (matched_hidraw ? g_udev_device_get_device_file (matched_hidraw->data) : NULL),
-                                        "fpi-udev-data-misc", (matched_misc ? g_udev_device_get_device_file (matched_misc->data) : NULL),
-                                        NULL);
+            if (cls->covered_by_lid)
+              {
+                add_lid_covered_device (context, driver, entry->driver_data,
+                                        (matched_spidev ? g_udev_device_get_device_file (matched_spidev->data) : NULL),
+                                        (matched_hidraw ? g_udev_device_get_device_file (matched_hidraw->data) : NULL),
+                                        (matched_misc ? g_udev_device_get_device_file (matched_misc->data) : NULL));
+              }
+            else
+              {
+                priv->pending_devices++;
+                g_async_initable_new_async (driver,
+                                            G_PRIORITY_LOW,
+                                            priv->cancellable,
+                                            async_device_init_done_cb,
+                                            context,
+                                            "fpi-driver-data", entry->driver_data,
+                                            "fpi-udev-data-spidev", (matched_spidev ? g_udev_device_get_device_file (matched_spidev->data) : NULL),
+                                            "fpi-udev-data-hidraw", (matched_hidraw ? g_udev_device_get_device_file (matched_hidraw->data) : NULL),
+                                            "fpi-udev-data-misc", (matched_misc ? g_udev_device_get_device_file (matched_misc->data) : NULL),
+                                            NULL);
+              }
             /* remove entries from list to avoid conflicts */
             if (matched_spidev)
               {
@@ -578,6 +816,7 @@ fp_context_enumerate (FpContext *context)
     /* free all unused elemnts in both lists */
     g_list_foreach (spidev_devices, (GFunc) g_object_unref, NULL);
     g_list_foreach (hidraw_devices, (GFunc) g_object_unref, NULL);
+    g_list_foreach (misc_devices, (GFunc) g_object_unref, NULL);
   }
 #endif
 
