+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#define FP_COMPONENT "lid"
+#include <fpi-log.h>
+
+#include "fpi-lid-switch.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <glib-unix.h>
+#include <gudev/gudev.h>
+#include <linux/input.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+/*
+ * FpiLidSwitch follows every input device that reports SW_LID and says
+ * whether the lid is closed. The kernel's switch state (EVIOCGSW) is the
+ * truth: events only tell us when to read it again, so a dropped event or a
+ * SYN_DROPPED cannot leave a stale state behind. Without a lid switch the
+ * lid counts as open, which keeps desktops and external readers unaffected.
+ *
+ * Lid switches can appear late (a platform driver loading after the daemon
+ * started), so input hotplug is followed as well.
+ */
+
+#define BITS_PER_LONG (sizeof (unsigned long) * 8)
+#define NLONGS(x) (((x) + BITS_PER_LONG - 1) / BITS_PER_LONG)
+
+typedef struct
+{
+  gchar *path;
+  gint   fd;
+  guint  watch_id;
+} FpiLidInput;
+
+struct _FpiLidSwitch
+{
+  GObject      parent;
+
+  GUdevClient *udev_client;
+  GHashTable  *inputs;   /* device file -> FpiLidInput */
+  gboolean     closed;
+};
+
+enum {
+  PROP_0,
+  PROP_CLOSED,
+  N_PROPS
+};
+static GParamSpec *properties[N_PROPS];
+
+G_DEFINE_TYPE (FpiLidSwitch, fpi_lid_switch, G_TYPE_OBJECT)
+
+static gboolean
+test_bit (guint bit, const unsigned long *array)
+{
+  return !!(array[bit / BITS_PER_LONG] & (1UL << (bit % BITS_PER_LONG)));
+}
+
+static void
+lid_input_free (FpiLidInput *input)
+{
+  g_clear_handle_id (&input->watch_id, g_source_remove);
+  if (input->fd >= 0)
+    close (input->fd);
+  g_free (input->path);
+  g_free (input);
+}
+
+static void
+lid_switch_update (FpiLidSwitch *self)
+{
+  GHashTableIter iter;
+  FpiLidInput *input;
+  gboolean closed = FALSE;
+
+  g_hash_table_iter_init (&iter, self->inputs);
+  while (g_hash_table_iter_next (&iter, NULL, (gpointer *) &input))
+    {
+      unsigned long state[NLONGS (SW_CNT)] = { 0 };
+
+      if (ioctl (input->fd, EVIOCGSW (sizeof (state)), state) < 0)
+        {
+          fp_dbg ("Cannot read switch state of %s: %s", input->path, g_strerror (errno));
+          continue;
+        }
+
+      /* Any closed lid covers the sensor. */
+      if (test_bit (SW_LID, state))
+        closed = TRUE;
+    }
+
+  if (closed == self->closed)
+    return;
+
+  self->closed = closed;
+  fp_info ("Lid %s", closed ? "closed" : "opened");
+  g_object_notify_by_pspec (G_OBJECT (self), properties[PROP_CLOSED]);
+}
+
+static gboolean
+lid_input_ready_cb (gint fd, GIOCondition condition, gpointer user_data)
+{
+  FpiLidSwitch *self = FPI_LID_SWITCH (user_data);
+  struct input_event events[16];
+  FpiLidInput *input = NULL;
+  GHashTableIter iter;
+  gboolean gone = (condition & (G_IO_HUP | G_IO_ERR)) != 0;
+
+  g_hash_table_iter_init (&iter, self->inputs);
+  while (g_hash_table_iter_next (&iter, NULL, (gpointer *) &input))
+    if (input->fd == fd)
+      break;
+
+  /* Drain; the content does not matter, the state is read back below. */
+  while (!gone)
+    {
+      gssize len = read (fd, events, sizeof (events));
+
+      if (len > 0)
+        continue;
+      if (len < 0 && errno == EINTR)
+        continue;
+      if (len < 0 && errno == EAGAIN)
+        break;
+
+      gone = TRUE;
+    }
+
+  if (gone)
+    {
+      if (input != NULL)
+        {
+          fp_dbg ("Lid switch %s went away", input->path);
+          input->watch_id = 0;
+          g_hash_table_remove (self->inputs, input->path);
+          lid_switch_update (self);
+        }
+      return G_SOURCE_REMOVE;
+    }
+
+  lid_switch_update (self);
+  return G_SOURCE_CONTINUE;
+}
+
+static void
+lid_switch_add_input (FpiLidSwitch *self, GUdevDevice *udev_device)
+{
+  unsigned long sw_bits[NLONGS (SW_CNT)] = { 0 };
+  const gchar *path = g_udev_device_get_device_file (udev_device);
+  FpiLidInput *input;
+  gint fd;
+
+  if (path == NULL || !g_str_has_prefix (path, "/dev/input/event"))
+    return;
+
+  if (g_hash_table_contains (self->inputs, path))
+    return;
+
+  /* With a udev database, only open devices that have switches at all;
+   * without one, fall back to asking the device. */
+  if (g_udev_device_has_property (udev_device, "ID_INPUT") &&
+      !g_udev_device_get_property_as_boolean (udev_device, "ID_INPUT_SWITCH"))
+    return;
+
+  fd = open (path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+  if (fd < 0)
+    {
+      fp_dbg ("Cannot open %s: %s", path, g_strerror (errno));
+      return;
+    }
+
+  if (ioctl (fd, EVIOCGBIT (EV_SW, sizeof (sw_bits)), sw_bits) < 0 ||
+      !test_bit (SW_LID, sw_bits))
+    {
+      close (fd);
+      return;
+    }
+
+  input = g_new0 (FpiLidInput, 1);
+  input->path = g_strdup (path);
+  input->fd = fd;
+  input->watch_id = g_unix_fd_add (fd, G_IO_IN | G_IO_HUP | G_IO_ERR,
+                                   lid_input_ready_cb, self);
+  g_hash_table_insert (self->inputs, input->path, input);
+
+  fp_dbg ("Following lid switch %s (%s)", path,
+          g_udev_device_get_sysfs_attr (udev_device, "device/name") ? : "unnamed");
+}
+
+static void
+lid_switch_uevent_cb (GUdevClient *client,
+                      const gchar *action,
+                      GUdevDevice *udev_device,
+                      gpointer     user_data)
+{
+  FpiLidSwitch *self = FPI_LID_SWITCH (user_data);
+  const gchar *path = g_udev_device_get_device_file (udev_device);
+
+  if (path == NULL)
+    return;
+
+  if (g_str_equal (action, "add") || g_str_equal (action, "change"))
+    lid_switch_add_input (self, udev_device);
+  else if (g_str_equal (action, "remove"))
+    g_hash_table_remove (self->inputs, path);
+  else
+    return;
+
+  lid_switch_update (self);
+}
+
+static void
+fpi_lid_switch_get_property (GObject    *object,
+                             guint       prop_id,
+                             GValue     *value,
+                             GParamSpec *pspec)
+{
+  FpiLidSwitch *self = FPI_LID_SWITCH (object);
+
+  switch (prop_id)
+    {
+    case PROP_CLOSED:
+      g_value_set_boolean (value, self->closed);
+      break;
+
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+    }
+}
+
+static void
+fpi_lid_switch_dispose (GObject *object)
+{
+  FpiLidSwitch *self = FPI_LID_SWITCH (object);
+
+  if (self->udev_client)
+    g_signal_handlers_disconnect_by_data (self->udev_client, self);
+  g_clear_object (&self->udev_client);
+  g_clear_pointer (&self->inputs, g_hash_table_unref);
+
+  G_OBJECT_CLASS (fpi_lid_switch_parent_class)->dispose (object);
+}
+
+static void
+fpi_lid_switch_class_init (FpiLidSwitchClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->get_property = fpi_lid_switch_get_property;
+  object_class->dispose = fpi_lid_switch_dispose;
+
+  properties[PROP_CLOSED] =
+    g_param_spec_boolean ("closed",
+                          "Closed",
+                          "Whether a laptop lid is closed",
+                          FALSE,
+                          G_PARAM_STATIC_STRINGS | G_PARAM_READABLE);
+
+  g_object_class_install_properties (object_class, N_PROPS, properties);
+}
+
+static void
+fpi_lid_switch_init (FpiLidSwitch *self)
+{
+  const gchar * const subsystems[] = { "input", NULL };
+  GList *devices, *l;
+
+  self->inputs = g_hash_table_new_full (g_str_hash, g_str_equal, NULL,
+                                        (GDestroyNotify) lid_input_free);
+
+  self->udev_client = g_udev_client_new (subsystems);
+  g_signal_connect (self->udev_client, "uevent",
+                    G_CALLBACK (lid_switch_uevent_cb), self);
+
+  devices = g_udev_client_query_by_subsystem (self->udev_client, "input");
+  for (l = devices; l; l = l->next)
+    lid_switch_add_input (self, l->data);
+  g_list_free_full (devices, g_object_unref);
+
+  lid_switch_update (self);
+}
+
+/**
+ * fpi_lid_switch_new:
+ *
+ * Follow the laptop lid switches of the system.
+ *
+ * Returns: (transfer full): a new #FpiLidSwitch
+ */
+FpiLidSwitch *
+fpi_lid_switch_new (void)
+{
+  return g_object_new (FPI_TYPE_LID_SWITCH, NULL);
+}
+
+/**
+ * fpi_lid_switch_get_closed:
+ * @self: a #FpiLidSwitch
+ *
+ * Returns: %TRUE if a lid is closed, %FALSE if it is open or there is none
+ */
+gboolean
+fpi_lid_switch_get_closed (FpiLidSwitch *self)
+{
+  g_return_val_if_fail (FPI_IS_LID_SWITCH (self), FALSE);
+
+  return self->closed;
+}
