diff --git a/libfprint/fpi-lid-switch.c b/libfprint/fpi-lid-switch.c
new file mode 100644
index 00000000..6a6a4ee5
--- /dev/null
+++ b/libfprint/fpi-lid-switch.c
@@ -0,0 +1,327 @@
+/*
+ * Laptop lid switch tracking
+ * Copyright (C) 2026 Ryan Murray <ryan@aurorasilicon.org>
+ *
