From: Ryan Murray <ryan@aurorasilicon.org>
Subject: [PATCH] aurora: ask for finger removal before retrying a stale contact

Map the kernel's additive REMOVE_FINGER status to libfprint's existing
remove-and-retry code for verify and identify. During enrolment, report
new removal guidance once per transition without inventing a passed stage.
Keep PRESENT while removal is needed and NEEDED when the sensor asks for
placement again. Older v4/v5 kernels never send the new values.

diff --git a/libfprint/drivers/aurora/aurora.c b/libfprint/drivers/aurora/aurora.c
index ab5b865..fa1bf43 100644
--- a/libfprint/drivers/aurora/aurora.c
+++ b/libfprint/drivers/aurora/aurora.c
@@ -37,6 +37,13 @@
 #define SEP_BIO_STATUS_REJECTED 7
 #endif
 
+#ifndef SEP_BIO_STATUS_REMOVE_FINGER
+#define SEP_BIO_STATUS_REMOVE_FINGER 8
+#endif
+#ifndef SEP_BIO_GUIDANCE_REMOVE_FINGER
+#define SEP_BIO_GUIDANCE_REMOVE_FINGER 4
+#endif
+
 struct _FpiDeviceAurora
 {
   FpDevice  parent;
@@ -45,6 +52,7 @@ struct _FpiDeviceAurora
   guint32   iface_version;
   guint     watch_id;
   guint32   enroll_last_reported_stage;
+  guint32   enroll_last_guidance;
 
   guint8    nonce[SEP_BIO_NONCE_LEN];
   gboolean  nonce_valid;
@@ -187,8 +195,12 @@ aurora_failure_new (const gchar *operation, guint32 status)
 /* The kernel reports an unusable capture without saying why it was unusable,
  * so the general retry is the most specific code that is always true. */
 static GError *
-aurora_retry_new (void)
+aurora_retry_new (guint32 status)
 {
+  if (status == SEP_BIO_STATUS_REMOVE_FINGER)
+    return fpi_device_retry_new_msg (FP_DEVICE_RETRY_REMOVE_FINGER,
+                                     "remove your finger, then place it on the sensor again");
+
   return fpi_device_retry_new_msg (FP_DEVICE_RETRY_GENERAL,
                                    "the capture was not usable; touch the sensor again");
 }
@@ -524,7 +536,8 @@ aurora_report_guidance (FpDevice *device, guint32 guidance, gboolean active)
 
   if (active)
     {
-      if (guidance == SEP_BIO_GUIDANCE_HOLD_STILL)
+      if (guidance == SEP_BIO_GUIDANCE_HOLD_STILL ||
+          guidance == SEP_BIO_GUIDANCE_REMOVE_FINGER)
         status = FP_FINGER_STATUS_PRESENT;
       else if (guidance == SEP_BIO_GUIDANCE_PLACE ||
                guidance == SEP_BIO_GUIDANCE_LIFT_AND_MOVE)
@@ -576,9 +589,14 @@ aurora_enrol_ready (gint fd, GIOCondition condition, gpointer user_data)
        * kernel reports each rejection in one poll only, and an accepted
        * capture clears it, so a rejection that shares a poll with a new stage
        * came after that stage. */
-      if (poll_res.status == SEP_BIO_STATUS_RETRY)
+      if (poll_res.guidance == SEP_BIO_GUIDANCE_REMOVE_FINGER &&
+          self->enroll_last_guidance != SEP_BIO_GUIDANCE_REMOVE_FINGER)
+        fpi_device_enroll_progress (device, self->enroll_last_reported_stage,
+                                    NULL, aurora_retry_new (SEP_BIO_STATUS_REMOVE_FINGER));
+      else if (poll_res.status == SEP_BIO_STATUS_RETRY)
         fpi_device_enroll_progress (device, self->enroll_last_reported_stage,
-                                    NULL, aurora_retry_new ());
+                                    NULL, aurora_retry_new (poll_res.status));
+      self->enroll_last_guidance = poll_res.guidance;
       return G_SOURCE_CONTINUE;
 
     case SEP_BIO_STATE_DONE:
@@ -718,6 +736,7 @@ aurora_enroll (FpDevice *device)
     }
 
   self->enroll_last_reported_stage = 0;
+  self->enroll_last_guidance = SEP_BIO_GUIDANCE_PLACE;
   aurora_report_guidance (device, SEP_BIO_GUIDANCE_PLACE, TRUE);
   aurora_stop_watch (self);
   self->watch_id = g_unix_fd_add (self->fd, G_IO_IN, aurora_enrol_ready, device);
@@ -834,8 +853,9 @@ aurora_verify_ready (gint fd, GIOCondition condition, gpointer user_data)
    * caller to ask for another touch: fprintd starts the match again on its
    * own, where a failure would end the authentication attempt. */
   else if (res.state == SEP_BIO_STATE_FAILED &&
-           res.status == SEP_BIO_STATUS_RETRY)
-    retry = aurora_retry_new ();
+           (res.status == SEP_BIO_STATUS_RETRY ||
+            res.status == SEP_BIO_STATUS_REMOVE_FINGER))
+    retry = aurora_retry_new (res.status);
 
   if (action == FPI_DEVICE_ACTION_VERIFY)
     {
