# SPDX-License-Identifier: GPL-2.0-only
[Unit]
Description=Touch ID re-arm request
Documentation=file:///usr/share/doc/aurora-touchid-rearm/README.md
CollectMode=inactive-or-failed

[Service]
ExecStart=/usr/libexec/aurora-touchid-rearm
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=30
# The ioctl needs CAP_SYS_ADMIN; pam_unix reads /etc/shadow.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH CAP_AUDIT_WRITE
NoNewPrivileges=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# The driver writes its lockout record in /var/lib from this process, so
# /var stays writable.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
