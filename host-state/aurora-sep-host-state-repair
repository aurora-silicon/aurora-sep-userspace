#!/usr/bin/python3 -I
# SPDX-License-Identifier: MIT
"""Repair a SEP host-state store that a power cut left short.

The driver refuses any file whose size is not the full 72-block store, and
does not reinitialise it: a short file that is not all zero may be the only
copy of the host state.  That is the right call for the driver, but it
leaves Touch ID dead until someone looks at the file.

The store is a superblock followed by copy-on-write slot blocks.  A short
file is normally a prefix of a valid store, cut off during a write (the
superblock is rewritten first and is therefore intact).  If the superblock
validates and every slot it names ends inside the file, zero-extending the
file back to the full size preserves all state.  Anything else is left in
place, unchanged: the driver keeps refusing it (Touch ID stays off), and
only an administrator decides to restore a copy or to reset the store with
--reset.  A power cut does not produce such a file, so it is not removed
on its own.

This runs from aurora-sep-host-state-repair.service before the loader
starts apple_sep; it never touches a file of the full size.  Before it
changes a store it copies it to the quarantine directory, which keeps the
newest KEEP_COPIES copies made under the current retention policy.  AURORA_SEP_HOST_STATE and AURORA_SEP_QUARANTINE
move the store and the backup directory, for tests and unusual installs.
"""

import os
import shutil
import sys
import time

STORE = os.environ.get("AURORA_SEP_HOST_STATE", "/var/lib/aurora-sep-host-state.bin")
QUARANTINE = os.environ.get("AURORA_SEP_QUARANTINE", "/var/lib/aurora-sep-quarantine")

BLOCK_SIZE = 0x8000
BLOCK_COUNT = 72
STORE_SIZE = BLOCK_SIZE * BLOCK_COUNT
SLOT_COUNT = BLOCK_COUNT - 1
MAX_VALUE = BLOCK_SIZE

MAGIC = b"AURORA-SEP-STOR\x01"
VERSION = 1

SB_MAGIC = 0
SB_VERSION = 16
SB_SLOT_COUNT = 20
SB_BLOCK_SIZE = 24
SB_GENERATION = 28
SB_INTENT_KIND = 36
SB_INTENT_SLOT = 37
SB_INTENT_TYPE = 39
SB_RESERVED = 40
SB_SLOT_TABLE = 64
SLOT_ENTRY_SIZE = 24
SB_SLOT_TABLE_END = SB_SLOT_TABLE + SLOT_COUNT * SLOT_ENTRY_SIZE

INTENT_NONE = 0
INTENT_WRITE = 1

# Quarantine copies kept: the one just made and the one before it.
KEEP_COPIES = 2
COPY_PREFIX = "host-state-managed-"
COPY_SUFFIX = ".bin"

# Under systemd (JOURNAL_STREAM set), "<4>" makes the journal record the line
# as a warning.
WARNING = "<4>" if os.environ.get("JOURNAL_STREAM") else ""


def log(message, prefix=""):
    print(f"{prefix}aurora-sep-host-state-repair: {message}", flush=True)


def warn(message):
    log(message, WARNING)


def le32(buf, off):
    return int.from_bytes(buf[off:off + 4], "little")


def le64(buf, off):
    return int.from_bytes(buf[off:off + 8], "little")


def all_zero(path, size):
    with open(path, "rb") as f:
        left = size
        while left:
            chunk = f.read(min(left, 1 << 20))
            if not chunk:
                return False
            if any(chunk):
                return False
            left -= len(chunk)
    return True


def validate_superblock(sb):
    """Return (ok, detail, highest_end).

    Mirrors Store::decode in drivers/soc/apple/store.rs.  highest_end is the
    first byte past the last data block the superblock names.
    """
    if len(sb) < SB_SLOT_TABLE_END:
        return False, "superblock too short", 0
    if sb[SB_MAGIC:SB_MAGIC + 16] != MAGIC:
        return False, "bad magic", 0
    if le32(sb, SB_VERSION) != VERSION:
        return False, "unsupported version", 0
    if le32(sb, SB_SLOT_COUNT) != SLOT_COUNT:
        return False, "slot count mismatch", 0
    if le32(sb, SB_BLOCK_SIZE) != BLOCK_SIZE:
        return False, "block size mismatch", 0
    if any(sb[SB_RESERVED:SB_SLOT_TABLE]):
        return False, "reserved header bytes are set", 0
    if any(sb[SB_SLOT_TABLE_END:BLOCK_SIZE]):
        return False, "reserved superblock bytes are set", 0

    slots = []
    seen = set()
    highest_end = 0
    for i in range(SLOT_COUNT):
        off = SB_SLOT_TABLE + i * SLOT_ENTRY_SIZE
        entry = sb[off:off + SLOT_ENTRY_SIZE]
        if not any(entry):
            slots.append(None)
            continue
        if entry[0] != 1:
            return False, f"slot {i}: bad used flag", 0
        if not 0xF0 <= entry[1] <= 0xF5:
            return False, f"slot {i}: unknown kind", 0
        length = le32(entry, 18)
        if length > MAX_VALUE:
            return False, f"slot {i}: value too large", 0
        if any(entry[22:]):
            return False, f"slot {i}: reserved bytes are set", 0
        key = (entry[1], bytes(entry[2:18]))
        if key in seen:
            return False, f"slot {i}: duplicate key", 0
        seen.add(key)
        slots.append(length)
        highest_end = max(highest_end, (i + 1) * BLOCK_SIZE + length)

    intent_kind = sb[SB_INTENT_KIND]
    intent_slot = int.from_bytes(
        sb[SB_INTENT_SLOT:SB_INTENT_SLOT + 2], "little"
    )
    intent_type = sb[SB_INTENT_TYPE]
    if intent_kind == INTENT_NONE:
        if intent_slot != 0 or intent_type != 0:
            return False, "bad empty intent", 0
    elif intent_kind == INTENT_WRITE:
        if intent_slot >= SLOT_COUNT:
            return False, "intent names an out-of-range slot", 0
        if slots[intent_slot] is not None:
            return False, "intent names a used slot", 0
        if not 0xF0 <= intent_type <= 0xF5:
            return False, "intent has an unknown kind", 0
    else:
        return False, "unknown intent", 0

    used = sum(1 for length in slots if length is not None)
    detail = (
        f"generation {le64(sb, SB_GENERATION)}, {used} used slot(s), "
        f"data ends at {highest_end}"
    )
    return True, detail, highest_end


def backup(path, size):
    os.makedirs(QUARANTINE, mode=0o700, exist_ok=True)
    os.chmod(QUARANTINE, 0o700)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    base = os.path.join(QUARANTINE, f"{COPY_PREFIX}{stamp}-{size}")
    dest = f"{base}{COPY_SUFFIX}"
    suffix = 1
    while True:
        try:
            dst = open(dest, "xb")
        except FileExistsError:
            dest = f"{base}-{suffix}{COPY_SUFFIX}"
            suffix += 1
            continue
        break
    with open(path, "rb") as src, dst:
        shutil.copyfileobj(src, dst)
        dst.flush()
        os.fsync(dst.fileno())
    os.chmod(dest, 0o600)
    prune(dest)
    return dest


def prune(newest):
    """Delete all but the newest KEEP_COPIES copies; newest is always kept.

    Only regular files named under the current retention policy are
    considered. Legacy copies can be the only copy of a refused store.
    """
    copies = []
    with os.scandir(QUARANTINE) as entries:
        for entry in entries:
            if not (entry.name.startswith(COPY_PREFIX) and entry.name.endswith(COPY_SUFFIX)):
                continue
            if not entry.is_file(follow_symlinks=False):
                continue
            if os.path.join(QUARANTINE, entry.name) == newest:
                continue
            copies.append((entry.stat(follow_symlinks=False).st_mtime_ns, entry.name))
    copies.sort(reverse=True)
    for _, name in copies[KEEP_COPIES - 1:]:
        try:
            os.unlink(os.path.join(QUARANTINE, name))
            log(f"removed the older copy {name} (keeping the newest {KEEP_COPIES})")
        except OSError as e:
            log(f"cannot remove the older copy {name}: {e}")


def admin_command():
    return f"{os.path.abspath(sys.argv[0])} --reset"


def reset():
    """--reset: an administrator's decision to drop a store the driver refuses.

    Copies the store to the quarantine and removes it, so the driver creates
    a fresh one the next time it loads.  A full-size store is left alone:
    it is either valid or one this helper never judges.
    """
    try:
        size = os.path.getsize(STORE)
    except FileNotFoundError:
        log(f"{STORE} does not exist; nothing to reset")
        return 0
    if size == STORE_SIZE:
        log(f"{STORE} has the full size of a store; not resetting it")
        return 1
    try:
        dest = backup(STORE, size)
    except OSError as e:
        log(f"cannot back up {STORE}: {e}")
        return 1
    os.unlink(STORE)
    log(
        f"copied {STORE} ({size} bytes) to {dest} and removed it; the driver "
        "creates a fresh store at the next boot. Touch ID enrolments and the "
        "password re-arm record must be set up again."
    )
    return 0


def main():
    try:
        size = os.path.getsize(STORE)
    except FileNotFoundError:
        log("no host-state store yet; leaving it to the driver")
        return 0
    except OSError as e:
        log(f"cannot stat {STORE}: {e}")
        return 1

    if size == STORE_SIZE:
        return 0

    # An interrupted first creation. The driver initialises these itself.
    if size == 0 or (size < STORE_SIZE and all_zero(STORE, size)):
        log(f"{STORE} is {size} bytes and holds no state; leaving it to the driver")
        return 0

    with open(STORE, "rb") as f:
        sb = f.read(BLOCK_SIZE)

    ok, detail, highest_end = validate_superblock(sb)
    header = sb[:64].hex()
    log(
        f"{STORE} is {size} bytes, expected {STORE_SIZE}; "
        f"superblock: {header}"
    )

    # Only a short prefix is extended. A file that is longer than a store is
    # never cut down to size.
    if ok and size < STORE_SIZE and highest_end <= size:
        try:
            dest = backup(STORE, size)
        except OSError as e:
            log(f"cannot back up the short store: {e}")
            return 1

        fd = os.open(STORE, os.O_RDWR)
        try:
            os.ftruncate(fd, STORE_SIZE)
            os.fsync(fd)
        finally:
            os.close(fd)
        log(
            f"{detail}; backed up as {dest} and zero-extended {STORE} to "
            f"{STORE_SIZE} bytes"
        )
        return 0

    # Not a power-cut prefix: the superblock does not validate, a used slot
    # ends past the cut, or the file is longer than a store. Leave it in
    # place; the driver refuses it as before, and nothing is lost.
    if not ok:
        why = detail
    elif size > STORE_SIZE:
        why = f"{detail}: the file is longer than a store"
    else:
        why = f"{detail}: a used slot ends past the file"
    warn(
        f"{why}; left {STORE} in place, unchanged. The SEP driver refuses it, "
        "so Touch ID stays off. To start over with an empty host state, as "
        f"root: {admin_command()}"
    )
    return 0


def usage():
    print(f"usage: {sys.argv[0]} [--reset]", file=sys.stderr)
    return 2

if __name__ == "__main__":
    if sys.argv[1:] == []:
        sys.exit(main())
    if sys.argv[1:] == ["--reset"]:
        sys.exit(reset())
    sys.exit(usage())
